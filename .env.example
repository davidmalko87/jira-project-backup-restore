# Jira Backup & Restore Tool — Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# =============================================================
# Jira Instance (used for both backup and restore)
# =============================================================

# Jira Cloud URL (no trailing slash)
JIRA_URL=https://your-domain.atlassian.net

# Email associated with your Atlassian account
JIRA_EMAIL=your-email@example.com

# API token — generate at: https://id.atlassian.com/manage-api-tokens
JIRA_API_TOKEN=

# Alternative: Cookie auth (for SSO/SAML when Basic Auth is blocked)
# Copy from browser DevTools -> Network -> any Jira request -> Cookie header
# Leave empty if using API token (recommended)
JIRA_COOKIE_HEADER=

# SSL verification (set to false only for self-signed certificates)
JIRA_VERIFY_SSL=true

# =============================================================
# Backup Settings
# =============================================================

# Root directory for backups (relative or absolute path)
BACKUP_ROOT=./backups

# Items per API page (max 100)
PAGE_SIZE=100

# Max retries for failed API calls and downloads
MAX_RETRIES=3

# Seconds between API calls (rate-limit throttle)
API_DELAY=0.2

# Bytes per chunk when streaming attachment downloads
CHUNK_SIZE=8192

# What to include in backups
INCLUDE_ATTACHMENTS=true
INCLUDE_CHANGELOG=true
INCLUDE_WORKLOGS=true

# =============================================================
# Standalone Attachment Upload (optional)
# =============================================================

# JQL template for finding Cloud issues by original key.
# Used only by "Upload attachments only" when key_mapping.json
# is not available (e.g. issues were imported via CSV).
#
# Placeholders: {orig_key} = original issue key, {project_key} = target project
# Examples:
#   project = {project_key} AND "Original Key" = "{orig_key}"
#   project = {project_key} AND cf[12345] = "{orig_key}"
LEGACY_KEY_JQL_TEMPLATE=
